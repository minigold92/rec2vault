{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuietClerk",
  "version": "0.0.3",
  "identifier": "io.github.minigold92.quietclerk",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "python3 ../scripts/prepare_app.py",
    "beforeDevCommand": "python3 ../scripts/prepare_app.py"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/uv", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["engine/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/minigold92/rec2vault/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RjhBNTBFQzM4NzA2OTYKUldTV0JvZkREcVg0T1cxRXI4SFBJNnkyQ3prSnN3Ui9sdXN5T0UxTlVBN09Gbno5VUs3cGlUbkwK"
    }
  }
}
