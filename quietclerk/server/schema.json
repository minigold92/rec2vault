{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quietclerk.local/server/schema.json",
  "title": "QuietClerk M1 local API responses",
  "description": "All API requests require a session except POST /api/session. GET / and /bootstrap.js are data-free authentication bootstrap resources. Mutations require exact Origin and CSRF (session exchange requires Origin and the one-use file token instead). Settings saves replace the entire TOML file and discard comments. A notes list and models APIs are not served yet. The web screens are HTML pages (/home, /jobs, /notes, /notes/<job>, /backlog, /settings, /migrate, /setup/1..6) and /static files; they need the same session (without it a screen navigation is redirected to / and a static file answers 401) and are not part of this JSON schema. SSE state payloads use Event. Idempotency-Key deduplicates mutation retries for the lifetime of a server process, up to 24 hours; state transitions are independently idempotent in the store. Remote inventory counts are unknown until S1; backlog is a partial local Syncthing need-list, not a complete phone inventory. Note migration: GET /api/notes/migration is a read-only preview of the output vault plus whether it is migrated; POST needs {consent: true} and runs on the executor thread between jobs (200 with the manifest if it ends within a second, otherwise 202 and the screen asks GET again; GET.task reports how the last request ended).",
  "x-endpoints": {
    "POST /api/session": {"request": "SessionRequest", "204": null, "401": null},
    "GET /api/session": {"200": "Session"},
    "POST /api/logout": {"204": null},
    "GET /api/status": {"200": "Status"},
    "GET /api/jobs": {"200": "Jobs"},
    "GET /api/jobs/{job_id}": {"200": "Detail"},
    "POST /api/jobs/{job_id}/process": {"request": "ProcessRequest", "202": null, "204": null, "409": "Conflict"},
    "POST /api/jobs/{job_id}/exclude": {"202": null, "409": "Conflict"},
    "POST /api/jobs/{job_id}/include": {"202": null, "204": null, "409": "Conflict"},
    "PUT /api/jobs/{job_id}/language": {"request": "LanguageRequest", "204": null},
    "POST /api/jobs/{job_id}/delete-local": {"request": "DeleteRequest", "202": null},
    "GET /api/jobs/{job_id}/audio": {"200": "binary audio/mp4", "206": "binary audio/mp4", "410": null, "416": null},
    "GET /api/settings": {"200": "Settings"},
    "PUT /api/settings": {"request": "SettingsChanges", "200": "Settings", "400": "FieldError", "409": "FieldError"},
    "GET /api/backlog": {"200": "Backlog"},
    "POST /api/backlog/request": {"request": "BacklogRequest", "202": null},
    "POST /api/pause": {"204": null}, "POST /api/resume": {"204": null}, "POST /api/scan": {"204": null},
    "GET /api/events": {"200": "text/event-stream; data: Event"},
    "GET /api/setup/checks": {"200": "Checks"}, "GET /api/setup/vaults": {"200": "Vaults"},
    "GET /api/providers": {"200": "Providers"}, "POST /api/providers/{name}/check": {"200": "ProviderCheck"},
    "GET /api/sync/pairing": {"200": "Pairing"}, "POST /api/sync/pairing/approve": {"request": "ApproveRequest", "204": null},
    "GET /api/sync/folder": {"200": "Folder"},
    "GET /api/notes/migration": {"200": "MigrationState", "409": "NoteConflictError"},
    "POST /api/notes/migration": {"request": "MigrationConsent", "200": "MigrationDone", "202": null, "400": "Error", "409": "NoteConflictError"}
  },
  "x-common-errors": {"400": "Error", "401": "Error", "403": "Error", "404": "Error", "409": "Conflict", "413": "Error", "503": "Error"},
  "$defs": {
    "NoteConflictError": {"type": "object", "required": ["error", "reason", "detail"], "properties": {"error": {"const": "note_conflict"}, "reason": {"type": "string"}, "detail": {"type": "string"}}},
    "MigrationConsent": {"type": "object", "required": ["consent"], "properties": {"consent": {"const": true}}, "additionalProperties": false},
    "MigrationPreview": {"type": "object", "required": ["output", "backup_root", "key_map", "value_map", "entries", "conflicts"], "properties": {"output": {"type": "string"}, "backup_root": {"type": "string"}, "key_map": {"type": "object"}, "value_map": {"type": "object"}, "entries": {"type": "array", "items": {"type": "object", "required": ["path", "conflicts"]}}, "conflicts": {"type": "array", "items": {"type": "object", "required": ["path", "reason"]}}}},
    "MigrationState": {"type": "object", "required": ["preview", "migrated", "task"], "properties": {"preview": {"$ref": "#/$defs/MigrationPreview"}, "migrated": {"type": "boolean"}, "task": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["running", "done", "failed"]}, "reason": {"type": "string"}}}]}}},
    "MigrationDone": {"type": "object", "required": ["output", "backup_root", "backup_dir", "done", "entries"], "properties": {"done": {"const": true}, "output": {"type": "string"}, "backup_root": {"type": "string"}, "backup_dir": {"type": "string"}, "entries": {"type": "array", "items": {"type": "object", "required": ["path"]}}}},
    "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
    "FieldError": {"type": "object", "required": ["field", "error"], "properties": {"field": {"type": "string"}, "error": {"type": "string"}}},
    "Conflict": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}},
    "SessionRequest": {"type": "object", "required": ["token"], "additionalProperties": false, "properties": {"token": {"type": "string"}}},
    "Session": {"type": "object", "required": ["csrf_token"], "properties": {"csrf_token": {"type": "string"}}},
    "ProcessRequest": {"type": "object", "properties": {"mode": {"enum": ["auto", "resume", "from_transcribe", "resummarize"]}}, "additionalProperties": false},
    "LanguageRequest": {"type": "object", "required": ["override"], "properties": {"override": {"enum": ["ko", "en", null]}}, "additionalProperties": false},
    "DeleteRequest": {"type": "object", "required": ["scope"], "properties": {"scope": {"const": "processing_data"}}, "additionalProperties": false},
    "BacklogRequest": {"type": "object", "required": ["names"], "properties": {"names": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "ApproveRequest": {"type": "object", "required": ["device_id"], "properties": {"device_id": {"type": "string"}}, "additionalProperties": false},
    "SettingsChanges": {"type": "object", "description": "Flat dotted keys or nested TOML-style objects. Only contract §3.3 keys; validated by quietclerk.config. Root/inbox and environment-locked keys return 409."},
    "Job": {"type": "object", "required": ["job_id", "sha256", "source_name", "status", "stage", "archive_path", "updated_at"], "properties": {"job_id": {"type": "string"}, "sha256": {"type": "string"}, "source_name": {"type": "string"}, "status": {"enum": ["skipped", "queued", "running", "retry_wait", "failed", "done"]}, "stage": {"type": ["string", "null"]}, "archive_path": {"type": ["string", "null"]}, "updated_at": {"type": "number"}}},
    "Stage": {"type": "object", "required": ["run_id", "stage", "seq", "status", "sent_fields"], "properties": {"run_id": {"type": "string"}, "stage": {"type": "string"}, "seq": {"type": "integer"}, "status": {"type": "string"}, "sent_fields": {"type": ["array", "string", "null"], "items": {"type": "string"}}}},
    "Run": {"type": "object", "required": ["run_id", "job_id", "mode", "status", "stages"], "properties": {"run_id": {"type": "string"}, "job_id": {"type": "string"}, "mode": {"type": "string"}, "status": {"type": "string"}, "stages": {"type": "array", "items": {"$ref": "#/$defs/Stage"}}}},
    "Jobs": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/Job"}}, "next_cursor": {"type": ["string", "null"]}}},
    "Detail": {"type": "object", "required": ["job", "runs"], "properties": {"job": {"$ref": "#/$defs/Job"}, "runs": {"type": "array", "items": {"$ref": "#/$defs/Run"}}}},
    "Status": {"type": "object", "required": ["boot_id", "engine", "paused", "counts", "current_job", "stage", "elapsed_sec", "last_progress", "providers", "sync"], "properties": {"boot_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "engine": {"type": "string"}, "paused": {"type": "boolean"}, "counts": {"type": "object", "additionalProperties": {"type": "integer"}}, "current_job": {"oneOf": [{"$ref": "#/$defs/Job"}, {"type": "null"}]}, "stage": {"oneOf": [{"$ref": "#/$defs/Stage"}, {"type": "null"}]}, "elapsed_sec": {"type": ["number", "null"]}, "last_progress": {"type": ["number", "null"]}, "providers": {"type": "array", "items": {"$ref": "#/$defs/Provider"}}, "sync": {"type": "object"}}},
    "Event": {"type": "object", "required": ["boot_id", "engine", "paused", "counts", "jobs"], "properties": {"jobs": {"type": "array", "items": {"type": "object", "required": ["job_id", "status", "stage", "updated_at"]}}}},
    "Settings": {"type": "object", "required": ["effective", "file", "environment_keys", "restart_required"], "properties": {"effective": {"type": "object"}, "file": {"type": "object"}, "environment_keys": {"type": "array", "items": {"type": "string"}}, "restart_required": {"type": "boolean"}}},
    "Backlog": {"type": "object", "required": ["names", "skipped", "inventory"], "properties": {"names": {"type": "array", "items": {"type": "string"}}, "skipped": {"type": "array", "items": {"$ref": "#/$defs/Job"}}, "inventory": {"enum": ["partial", "unavailable"]}}},
    "Provider": {"type": "object", "required": ["name", "installed", "logged_in", "version", "tool_block", "endpoint_class"], "properties": {"name": {"type": "string"}, "installed": {"type": "boolean"}, "logged_in": {"type": ["boolean", "null"]}, "version": {"type": "string"}, "tool_block": {"type": "string"}, "endpoint_class": {"enum": ["local", "external", "unknown"]}}},
    "Providers": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/Provider"}}}},
    "ProviderCheck": {"type": "object", "required": ["ok", "sent_fields", "endpoint_class"], "properties": {"ok": {"type": "boolean"}, "reason": {"type": "string"}, "synthetic": {"type": "boolean"}, "sent_fields": {"type": "array", "items": {"type": "string"}}, "endpoint_class": {"enum": ["local", "external", "unknown"]}}},
    "Checks": {"type": "object", "required": ["chip", "supported", "memory_bytes", "disk_free_bytes", "ffmpeg", "uv"], "properties": {"chip": {"type": "string"}, "supported": {"type": "boolean"}, "memory_bytes": {"type": ["integer", "null"]}, "disk_free_bytes": {"type": "integer"}, "ffmpeg": {"type": "object", "required": ["installed", "remedy"]}, "uv": {"type": "object", "required": ["installed", "remedy"]}}},
    "Vaults": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"type": "object", "required": ["path", "exists"], "properties": {"path": {"type": "string"}, "exists": {"type": "boolean"}}}}}},
    "Pairing": {"type": "object", "required": ["device_id", "qr_data", "pending"], "properties": {"device_id": {"type": "string"}, "qr_data": {"type": "string"}, "pending": {"type": "array", "items": {"type": "object", "required": ["device_id"]}}}},
    "Folder": {"type": "object", "required": ["state", "folder_id", "phone_recordings", "count_reason"], "properties": {"state": {"enum": ["not_shared", "awaiting_acceptance", "connected"]}, "folder_id": {"type": ["string", "null"]}, "phone_recordings": {"type": "null"}, "count_reason": {"const": "remote_inventory_unavailable"}}}
  }
}
